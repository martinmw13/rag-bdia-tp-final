%% Modelo físico - índice de vistas
%% El detalle exhaustivo permanece en db/estructura/ y db/indices_vistas/.
flowchart LR
    PG[("PostgreSQL 17<br/>vector + btree_gist")]
    PG --> OP["Operación<br/>fisico_operacion.mmd"]
    PG --> REC["Almacenamiento y recuperación<br/>fisico_recuperacion.mmd"]
    PG --> SEG["Seguridad y trazabilidad<br/>fisico_seguridad.mmd"]

    OP --> REGLAS_OP["PK · FK · UK · CHECK<br/>snapshots · vigencia · GiST"]
    REC --> REGLAS_REC["Tipos y claves<br/>JSONB · VECTOR(32)<br/>vigencia · GiST · HNSW"]
    SEG --> REGLAS_SEG["FK compuesta · RLS<br/>privilegios · funciones · triggers"]

    SQL["DDL e índices SQL<br/>referencia exhaustiva"]
    NOTAS["fisico_notas.md<br/>reglas transversales"]
    REGLAS_OP -.-> SQL
    REGLAS_REC -.-> SQL
    REGLAS_SEG -.-> SQL
    REGLAS_OP -.-> NOTAS
    REGLAS_REC -.-> NOTAS
    REGLAS_SEG -.-> NOTAS
