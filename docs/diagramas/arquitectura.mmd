%% Arquitectura general: un único recorrido de los datos.
%% La aplicación y el LLM se muestran sólo como contexto y quedan fuera del TP.
flowchart TD
    GEN["Generador reproducible<br/>scripts/generar_datos.py"]
    SQL["Seed SQL"]
    DOCS["Documentos Markdown"]
    MAN["Manifiesto y checksums"]

    GEN --> SQL
    GEN --> DOCS
    GEN --> MAN

    CARGA["Carga y configuración<br/>DDL · índices · RLS · roles"]
    SQL --> CARGA
    DOCS -. "ruta + SHA-256" .-> CARGA
    MAN -. "control reproducible" .-> CARGA

    PG[("PostgreSQL 17<br/>datos operativos + corpus + pgvector")]
    CARGA --> PG

    APP["Aplicación / LLM<br/>fuera de alcance"]
    CONTEXTO["Actor y perfil<br/>contexto transaccional"]
    REC["Recuperación autorizada<br/>vista + RLS + vigencia + HNSW"]
    TRAZA["Consulta · respuesta · evidencia"]
    AUD["Auditoría append-only<br/>funciones y triggers"]

    CONTEXTO --> PG
    PG --> REC --> TRAZA
    TRAZA -. "respuesta fundamentada" .-> APP
    TRAZA --> AUD
    PG -. "publicación y revocación" .-> AUD

    ROLES["Roles técnicos<br/>ingesta · documental · runtime · auditor"]
    ROLES -. "privilegios mínimos" .-> PG

    style APP fill:#eee,stroke:#999,color:#666
