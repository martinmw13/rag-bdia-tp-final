%% =============================================================================
%% Modelo lógico - Capa de datos para un copiloto RAG interno
%% =============================================================================
%% Entidades, atributos y relaciones con tipos lógicos (independientes del
%% motor) y claves. No incluye tipos físicos de PostgreSQL, restricciones CHECK,
%% índices ni exclusiones: eso corresponde al modelo físico (fisico.mmd).
%% Fuente de autoridad: db/estructura/01_schema.sql.
%% =============================================================================
erDiagram
    CATEGORIA_PRODUCTO {
        integer id PK
        string  codigo UK
        string  nombre
        boolean activo
    }

    SEGMENTO_CLIENTE {
        integer id PK
        string  codigo UK
        string  nombre
        boolean activo
    }

    PERFIL_AUTORIZADO {
        integer id PK
        string  codigo UK
        string  nombre
        boolean activo
    }

    CLASE_DOCUMENTAL {
        integer id PK
        string  codigo UK
        string  nombre
        string  descripcion
        boolean activo
    }

    NIVEL_SENSIBILIDAD {
        integer id PK
        string  codigo UK
        string  nombre
        boolean requiere_auditoria
        boolean activo
    }

    MODELO_EMBEDDING {
        integer id PK
        string  nombre UK
        string  version UK
        integer dimension
        string  metrica
        boolean activo
    }

    PRODUCTO {
        integer id PK
        string  codigo UK
        string  nombre
        string  descripcion
        integer categoria_id FK
        boolean activo
    }

    CLIENTE {
        integer id PK
        string  codigo UK
        string  razon_social
        integer segmento_id FK
        boolean activo
    }

    PROVEEDOR {
        integer id PK
        string  codigo UK
        string  razon_social
        boolean activo
    }

    PRODUCTO_PROVEEDOR {
        integer producto_id PK,FK
        integer proveedor_id PK,FK
    }

    CONDICION_COMERCIAL {
        integer id PK
        integer cliente_id FK
        integer producto_id FK
        decimal precio_unitario
        decimal descuento_porcentaje
        date    vigente_desde
        date    vigente_hasta "nulo = sin fin"
    }

    PEDIDO {
        integer id PK
        string  codigo UK
        integer cliente_id FK
        date    fecha
        string  estado "pendiente | en_preparacion | entregado | cancelado"
    }

    LINEA_PEDIDO {
        integer id PK
        integer pedido_id FK
        integer numero_linea UK "único por pedido"
        integer producto_id FK,UK "único por pedido"
        integer cantidad
        decimal precio_unitario "snapshot al momento del pedido"
        decimal descuento_porcentaje "snapshot al momento del pedido"
    }

    ENTREGA {
        integer id PK
        string  codigo UK
        integer pedido_id FK
        date    fecha_programada
        date    fecha_efectiva
        string  estado "planificada | en_transito | entregada | demorada | cancelada"
    }

    INCIDENCIA_OPERATIVA {
        integer id PK
        string  codigo UK
        integer entrega_id FK
        date    fecha
        string  tipo "demora | faltante | dano | direccion_erronea | otro"
        string  descripcion
        string  estado "abierta | en_revision | cerrada"
    }

    DOCUMENTO {
        integer id PK
        string  codigo UK
        string  titulo
        integer clase_id FK
        integer sensibilidad_id FK
        string  procedencia
        boolean activo
    }

    VERSION_DOCUMENTAL {
        integer   id PK
        integer   documento_id FK
        integer   numero_version UK "único por documento"
        string    estado "borrador | publicada | sustituida | revocada"
        datetime  vigente_desde
        datetime  vigente_hasta "nulo = sin fin"
        datetime  publicada_en
        datetime  revocada_en
        string    ruta_relativa "vínculo al archivo original, fuera de la base"
        string    nombre_archivo
        string    tipo_mime
        integer   tamano_bytes
        string    sha256 "integridad del archivo original"
        json      metadatos "acotado: no se filtra ni autoriza"
    }

    FRAGMENTO {
        integer id PK
        integer version_id FK
        integer posicion UK "único por versión"
        string  titulo
        string  contenido
        integer pagina "opcional"
    }

    EMBEDDING {
        integer  id PK
        integer  fragmento_id FK,UK "único junto a modelo_id"
        integer  modelo_id FK,UK "único junto a fragmento_id"
        vector   vector "dimensión y métrica del modelo"
        datetime generado_en
    }

    DOCUMENTO_PRODUCTO {
        integer documento_id PK,FK
        integer producto_id PK,FK
    }

    DOCUMENTO_PROVEEDOR {
        integer documento_id PK,FK
        integer proveedor_id PK,FK
    }

    ACTOR {
        integer id PK
        string  codigo UK
        string  nombre
        integer perfil_autorizado_id FK
        boolean activo
    }

    PERMISO_DOCUMENTAL {
        integer perfil_id PK,FK
        integer clase_id PK,FK
    }

    CONSULTA {
        integer  id PK
        integer  actor_id FK
        integer  perfil_efectivo_id FK "debe coincidir con el perfil del actor"
        string   pregunta
        datetime instante
    }

    RESPUESTA {
        integer  id PK
        integer  consulta_id FK,UK "cero o una respuesta por consulta"
        string   tipo_resultado "exito | sin_resultados | sin_fuente_autorizada | acceso_denegado"
        string   contenido
        datetime instante
    }

    RESULTADO_ESTRUCTURADO {
        integer  id PK
        string   tipo_consulta "identifica una consulta predefinida"
        json     parametros
        json     contenido "snapshot inmutable"
        datetime generado_en
        string   hash
    }

    EVIDENCIA_DOCUMENTAL {
        integer id PK
        integer respuesta_id FK,UK "sin repetir embedding ni ranking por respuesta"
        integer embedding_id FK,UK
        integer ranking UK
        decimal score
    }

    EVIDENCIA_ESTRUCTURADA {
        integer id PK
        integer respuesta_id FK,UK "sin pares repetidos"
        integer resultado_estructurado_id FK,UK
    }

    EVENTO_AUDITORIA {
        integer  id PK
        integer  actor_id FK "nulo si el contexto era inválido"
        integer  perfil_efectivo_id FK
        datetime instante
        string   accion "carga_borrador | publicacion | sustitucion | revocacion | ..."
        string   resultado "permitido | denegado | rechazado"
        string   recurso_tipo
        integer  recurso_id
        integer  consulta_id FK
        integer  respuesta_id FK
        integer  ranking
        decimal  score
        json     detalles
    }

    CATEGORIA_PRODUCTO ||--o{ PRODUCTO : clasifica
    SEGMENTO_CLIENTE   ||--o{ CLIENTE  : agrupa
    PRODUCTO           ||--o{ PRODUCTO_PROVEEDOR : ""
    PROVEEDOR          ||--o{ PRODUCTO_PROVEEDOR : ""
    CLIENTE            ||--o{ CONDICION_COMERCIAL : ""
    PRODUCTO           ||--o{ CONDICION_COMERCIAL : ""
    CLIENTE            ||--o{ PEDIDO : ""
    PEDIDO             ||--|{ LINEA_PEDIDO : ""
    PRODUCTO           ||--o{ LINEA_PEDIDO : ""
    PEDIDO             ||--o{ ENTREGA : ""
    ENTREGA            ||--o{ INCIDENCIA_OPERATIVA : ""
    CLASE_DOCUMENTAL   ||--o{ DOCUMENTO : ""
    NIVEL_SENSIBILIDAD ||--o{ DOCUMENTO : ""
    DOCUMENTO          ||--|{ VERSION_DOCUMENTAL : ""
    VERSION_DOCUMENTAL ||--|{ FRAGMENTO : ""
    FRAGMENTO          ||--o{ EMBEDDING : ""
    MODELO_EMBEDDING   ||--o{ EMBEDDING : ""
    DOCUMENTO          ||--o{ DOCUMENTO_PRODUCTO : ""
    PRODUCTO           ||--o{ DOCUMENTO_PRODUCTO : ""
    DOCUMENTO          ||--o{ DOCUMENTO_PROVEEDOR : ""
    PROVEEDOR          ||--o{ DOCUMENTO_PROVEEDOR : ""
    PERFIL_AUTORIZADO  ||--o{ ACTOR : ""
    PERFIL_AUTORIZADO  ||--o{ PERMISO_DOCUMENTAL : ""
    CLASE_DOCUMENTAL   ||--o{ PERMISO_DOCUMENTAL : ""
    ACTOR              ||--o{ CONSULTA : ""
    PERFIL_AUTORIZADO  ||--o{ CONSULTA : ""
    CONSULTA           ||--o| RESPUESTA : ""
    RESPUESTA          ||--o{ EVIDENCIA_DOCUMENTAL : ""
    EMBEDDING          ||--o{ EVIDENCIA_DOCUMENTAL : ""
    RESPUESTA          ||--o{ EVIDENCIA_ESTRUCTURADA : ""
    RESULTADO_ESTRUCTURADO ||--o{ EVIDENCIA_ESTRUCTURADA : ""
    ACTOR              |o--o{ EVENTO_AUDITORIA : ""
    PERFIL_AUTORIZADO  |o--o{ EVENTO_AUDITORIA : ""
    CONSULTA           |o--o{ EVENTO_AUDITORIA : ""
    RESPUESTA          |o--o{ EVENTO_AUDITORIA : ""
